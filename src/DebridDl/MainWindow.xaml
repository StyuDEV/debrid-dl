<Window x:Class="DebridDl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Debrid DL" Width="920" Height="660" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterScreen" Icon="icon.ico"
        Background="#15171C" Foreground="#E7E9EE" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#1E2128"/>
        <SolidColorBrush x:Key="Field" Color="#111318"/>
        <SolidColorBrush x:Key="Line" Color="#2C3039"/>
        <SolidColorBrush x:Key="Muted" Color="#8B92A1"/>
        <SolidColorBrush x:Key="Accent" Color="#4C8DFF"/>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Field}"/>
            <Setter Property="Foreground" Value="#E7E9EE"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="CaretBrush" Value="#E7E9EE"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Button" TargetType="Button">
            <Setter Property="Background" Value="#2A2E37"/>
            <Setter Property="Foreground" Value="#E7E9EE"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Button}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Icon" TargetType="Button" BasedOn="{StaticResource Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="9"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2E37"/>
                    <Setter Property="Foreground" Value="#E7E9EE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#2A2E37" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="3" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="20,16,20,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Debrid DL" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" Margin="10,0,0,3"
                           VerticalAlignment="Bottom"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="UpdateButton" Style="{StaticResource Primary}" Visibility="Collapsed"
                        Margin="0,0,12,0" Click="Update_Click"/>
                <TextBlock x:Name="AccountText" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <Button Style="{StaticResource Icon}" Content="&#xE713;" ToolTip="Réglages" Click="Settings_Click"/>
            </StackPanel>
        </Grid>

        <Border x:Name="SettingsPanel" Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10"
                Margin="20,0,20,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Clé AllDebrid" Style="{StaticResource Label}"/>
                <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Hyperlink NavigateUri="https://alldebrid.com/apikeys/" RequestNavigate="Link_Navigate"
                                   Foreground="{StaticResource Accent}">Créer une clé</Hyperlink>
                    </TextBlock>
                    <TextBox x:Name="KeyBox" LostFocus="Key_LostFocus"/>
                </DockPanel>

                <TextBlock Grid.Row="1" Text="Connexions par fichier" Style="{StaticResource Label}"
                           Margin="0,10,12,0"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBox x:Name="ConnectionsBox" Width="60" LostFocus="Numbers_LostFocus"/>
                    <TextBlock Text="Fichiers en même temps" Style="{StaticResource Label}" Margin="24,0,12,0"/>
                    <TextBox x:Name="ParallelBox" Width="60" LostFocus="Numbers_LostFocus"/>
                </StackPanel>

                <CheckBox x:Name="ClipboardBox" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0"
                          Foreground="#E7E9EE" Click="Clipboard_Click"
                          Content="Récupérer les liens copiés (hébergeurs AllDebrid)"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10" Margin="20,0,20,12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <TextBox x:Name="LinksBox" Height="96" AcceptsReturn="True" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" TextChanged="Links_TextChanged"/>
                    <TextBlock x:Name="LinksHint" Margin="10,8" IsHitTestVisible="False"
                               Foreground="{StaticResource Muted}"
                               Text="Colle tes liens ici, un par ligne. Les liens copiés arrivent tout seuls."/>
                </Grid>

                <DockPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Télécharger"
                            Margin="8,0,0,0" Click="Add_Click"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button}" Content="Parcourir…"
                            Margin="8,0,0,0" Click="Browse_Click"/>
                    <TextBlock DockPanel.Dock="Left" Text="Dossier" Style="{StaticResource Label}"/>
                    <TextBox x:Name="FolderBox"/>
                </DockPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <TextBlock x:Name="EmptyText" Text="Aucun téléchargement" Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="14,10"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name, Mode=OneWay}"/>
                                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                                     Foreground="{Binding Color, Mode=OneWay}" Margin="0,8,0,6"/>
                                        <TextBlock Text="{Binding Details, Mode=OneWay}" FontSize="12"
                                                   Foreground="{StaticResource Muted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource Icon}" Click="Toggle_Click"
                                                Content="{Binding ActionGlyph, Mode=OneWay}"
                                                ToolTip="{Binding ActionTip, Mode=OneWay}"
                                                Visibility="{Binding ActionVisibility, Mode=OneWay}"/>
                                        <Button Style="{StaticResource Icon}" Content="&#xE838;"
                                                ToolTip="Ouvrir le dossier" Click="Open_Click"/>
                                        <Button Style="{StaticResource Icon}" Content="&#xE711;"
                                                ToolTip="Retirer" Click="Remove_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Button}" Content="Tout reprendre" Click="ResumeAll_Click"/>
                    <Button Style="{StaticResource Button}" Content="Tout mettre en pause" Margin="8,0,0,0"
                            Click="PauseAll_Click"/>
                    <Button Style="{StaticResource Button}" Content="Retirer les terminés" Margin="8,0,0,0"
                            Click="ClearDone_Click"/>
                </StackPanel>
                <TextBlock x:Name="TotalText" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
